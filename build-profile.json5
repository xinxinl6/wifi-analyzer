            "pc"
          ]
        }
      ]
    },
    {
      "name": "network_tools",
      "srcPath": "./features/network-tools",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "tablet",
            "pc"
          ]
        }
      ]
    },
    {
      "name": "speed_test",
      "srcPath": "./speed-test",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "tablet",
            "pc"
          ]
        }
      ]
