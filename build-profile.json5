{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "5.0.2(14)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "tablet",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "5.0.2(14)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "pc",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "5.0.2(14)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "phone",
      "srcPath": "./products/phone",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "tablet",
      "srcPath": "./products/tablet",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "tablet"
          ]
        }
      ]
    },
    {
      "name": "pc",
      "srcPath": "./products/pc",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "pc"
          ]
        }
      ]
    },
    {
      "name": "wifi_base",
      "srcPath": "./commons/wifi-base",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "tablet",
            "pc"
          ]
        }
      ]
    },
    {
      "name": "native_ping",
      "srcPath": "./commons/native-ping",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "tablet",
            "pc"
          ]
        }
      ]
    },
    {
