{
  "module": {
    "name": "pc",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "PcAbility",
    "deviceTypes": ["2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {"name": "ohos.permission.GET_WIFI_INFO", "reason": "$string:wifi_permission_reason"},
      {"name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:location_permission_reason", "usedScene": {"abilities": ["PcAbility"], "when": "inuse"}},
      {"name": "ohos.permission.INTERNET", "reason": "$string:internet_permission_reason"},
      {"name": "ohos.permission.GET_NETWORK_INFO", "reason": "$string:network_info_permission_reason"}
    ],
    "abilities": [
      {
        "name": "PcAbility",
        "srcEntry": "./ets/entryability/PcAbility.ets",
        "description": "$string:PcAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:PcAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "PcBackupAbility",
        "srcEntry": "./ets/entrybackupability/PcBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
