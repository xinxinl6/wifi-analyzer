{
  "module": {
    "name": "phone",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "PhoneAbility",
    "deviceTypes": ["phone"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {"name": "ohos.permission.GET_WIFI_INFO", "reason": "$string:wifi_permission_reason"},
      {"name": "ohos.permission.LOCATION", "reason": "$string:location_permission_reason", "usedScene": {"abilities": ["PhoneAbility"], "when": "inuse"}},
      {"name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:location_permission_reason", "usedScene": {"abilities": ["PhoneAbility"], "when": "inuse"}},
      {"name": "ohos.permission.INTERNET", "reason": "$string:internet_permission_reason"},
      {"name": "ohos.permission.GET_NETWORK_INFO", "reason": "$string:network_info_permission_reason"}
    ],
    "abilities": [
      {
        "name": "PhoneAbility",
        "srcEntry": "./ets/entryability/PhoneAbility.ets",
        "description": "$string:PhoneAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:PhoneAbility_label",
        "startWindowIcon": "$media:layered_image",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          }
        ]
      }
    ]
  }
}
